# .env.example — مقادیر نمونه. فایل واقعی (.env) gitignore شده و هرگز commit نمی‌شود.

# --- پایگاه داده (Prisma) ---
# توسعه/آزمون: SQLite. تولید: provider=postgresql و DATABASE_URL متناظر
# (DATABASE_ARCHITECTURE §۲.۴ — schema.prisma datasource).
DATABASE_URL="file:./dev.db"

# --- احراز هویت (D-01 / CD-17) ---
# کلید امضای توکن دسترسی — حداقل ۳۲ نویسه. در تولید حتماً چرخش شود.
AUTH_SECRET="lY8G7LTW-AugH_ZYk3OTuipDMVeEh4X07_EGPF0WI628avHqyXv3vGDb2n9pQcfk"
# فعال‌سازی ویژگی Secure روی کوکی نشست (فقط HTTPS تولید).
AUTH_COOKIE_SECURE="false"

# --- seed پایگاه داده توسعه (scripts/seed) ---
SEED_ADMIN_NAME="admin"
SEED_ADMIN_PASSWORD="barman-admin-1405"

# --- لاگ سمت کلاینت ---
NEXT_PUBLIC_LOG_LEVEL="warn"

# --- مهاجرت داده (فاز ۸ — اختیاری) ---
# مسیر خروجی گزارش مهاجرت (پیش‌فرض: docs/reports/MIGRATION_REPORT.md)
# MIGRATION_REPORT_OUT="docs/reports/MIGRATION_REPORT.md"
# مسیر پایگاه داده موقت آزمون مهاجرت (پیش‌فرض: تمپ سیستم)
# MIGRATION_TEST_DB=""
